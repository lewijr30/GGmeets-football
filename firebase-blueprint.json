{
  "entities": {
    "AdminLock": {
      "title": "AdminLock",
      "description": "One-time bootstrap lock preventing unauthorized admin key registration after initial setup.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Singleton lock identifier ('admin_lock').",
          "enum": ["admin_lock"],
          "maxLength": 32
        },
        "locked": {
          "type": "boolean",
          "description": "Indicates bootstrap lock is active."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of bootstrap initialization."
        }
      },
      "required": ["id", "locked", "createdAt"]
    },
    "AdminKey": {
      "title": "AdminKey",
      "description": "Server-derived 192-bit HMAC admin capability key record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "192-bit capability key prefixed with adm-.",
          "minLength": 52,
          "maxLength": 52,
          "pattern": "^adm-[a-f0-9]{48}$"
        },
        "lastAdminOpId": {
          "type": "string",
          "description": "Optional admin operation nonce when rotating keys.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^op-[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["id", "createdAt"]
    },
    "AdminOp": {
      "title": "AdminOp",
      "description": "Unreadable one-time atomic write proof verifying possession of the server AdminKey.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique one-time operation nonce.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^op-[a-zA-Z0-9_\\-]+$"
        },
        "adminKey": {
          "type": "string",
          "description": "Secret server-derived capability key verified against /admin_keys.",
          "minLength": 52,
          "maxLength": 52,
          "pattern": "^adm-[a-f0-9]{48}$"
        },
        "action": {
          "type": "string",
          "description": "Audited server/admin mutation type.",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the atomic batch."
        }
      },
      "required": ["id", "adminKey", "action", "createdAt"]
    },
    "Match": {
      "title": "Match",
      "description": "Publicly visible pickup football match in Addis Ababa with live spot capacity tracking.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique match identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Display title of the football match.",
          "minLength": 1,
          "maxLength": 120
        },
        "event_type": {
          "type": "string",
          "description": "Match format category.",
          "enum": ["5-a-side", "7-a-side", "Full Field"],
          "maxLength": 30
        },
        "date": {
          "type": "string",
          "description": "Match date label.",
          "minLength": 1,
          "maxLength": 60
        },
        "time": {
          "type": "string",
          "description": "Match kickoff and end time window.",
          "minLength": 1,
          "maxLength": 60
        },
        "location": {
          "type": "string",
          "description": "Pitch name and neighborhood in Addis Ababa.",
          "minLength": 1,
          "maxLength": 160
        },
        "price": {
          "type": "number",
          "description": "Entry fee per player in ETB."
        },
        "total_spots": {
          "type": "number",
          "description": "Maximum allowed bookings before registration closes."
        },
        "verified_spots": {
          "type": "number",
          "description": "Count of admin-approved player spots."
        },
        "pending_spots": {
          "type": "number",
          "description": "Count of pending payment submissions reserving spots."
        },
        "image_url": {
          "type": "string",
          "description": "Pitch cover image URL or compressed JPEG data URL.",
          "minLength": 5,
          "maxLength": 700000
        },
        "description": {
          "type": "string",
          "description": "Match rules, footwear requirements, and notes.",
          "minLength": 0,
          "maxLength": 1000
        },
        "amenities": {
          "type": "array",
          "description": "Bounded list of up to 10 pitch amenities."
        },
        "visibility": {
          "type": "string",
          "description": "Visibility state for query enforcement ('live' or 'archived').",
          "enum": ["live", "archived"],
          "maxLength": 16
        },
        "lastBookingId": {
          "type": "string",
          "description": "ID of most recent player booking reservation.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lastAdminOpId": {
          "type": "string",
          "description": "ID of atomic AdminOp authorizing the latest write.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^op-[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "id",
        "title",
        "event_type",
        "date",
        "time",
        "location",
        "price",
        "total_spots",
        "verified_spots",
        "pending_spots",
        "image_url",
        "description",
        "amenities",
        "visibility",
        "lastBookingId",
        "lastAdminOpId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Admin-isolated player spot registration and Telebirr/CBE payment receipt record containing player PII.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique booking identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "inboxKey": {
          "type": "string",
          "description": "Parent admin capability inbox key for strict query enforcement.",
          "minLength": 52,
          "maxLength": 52,
          "pattern": "^adm-[a-f0-9]{48}$"
        },
        "passId": {
          "type": "string",
          "description": "Paired non-PII capability pass identifier.",
          "minLength": 20,
          "maxLength": 128,
          "pattern": "^pass-[a-zA-Z0-9_\\-]+$"
        },
        "event_id": {
          "type": "string",
          "description": "Referenced Match document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "match_title": {
          "type": "string",
          "description": "Snapshot of match title.",
          "minLength": 1,
          "maxLength": 120
        },
        "match_date": {
          "type": "string",
          "description": "Snapshot of match date.",
          "minLength": 1,
          "maxLength": 60
        },
        "match_time": {
          "type": "string",
          "description": "Snapshot of match time.",
          "minLength": 1,
          "maxLength": 60
        },
        "match_location": {
          "type": "string",
          "description": "Snapshot of match location.",
          "minLength": 1,
          "maxLength": 160
        },
        "player_name": {
          "type": "string",
          "description": "Full name of the registered player.",
          "minLength": 1,
          "maxLength": 80
        },
        "player_phone": {
          "type": "string",
          "description": "Player phone number (PII isolated inside secret admin inbox).",
          "minLength": 3,
          "maxLength": 30
        },
        "amount": {
          "type": "number",
          "description": "Payment amount in ETB."
        },
        "payment_method": {
          "type": "string",
          "description": "Mobile banking channel used.",
          "enum": ["Telebirr", "CBE"],
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "description": "Verification status controlled by Host Admin.",
          "enum": ["pending", "approved", "rejected"],
          "maxLength": 20
        },
        "screenshot_url": {
          "type": "string",
          "description": "Compressed transfer receipt screenshot.",
          "minLength": 10,
          "maxLength": 700000
        },
        "lastAdminOpId": {
          "type": "string",
          "description": "ID of atomic AdminOp authorizing the write.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^op-[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest status review."
        }
      },
      "required": [
        "id",
        "inboxKey",
        "passId",
        "event_id",
        "match_title",
        "match_date",
        "match_time",
        "match_location",
        "player_name",
        "player_phone",
        "amount",
        "payment_method",
        "status",
        "screenshot_url",
        "lastAdminOpId",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookingPass": {
      "title": "BookingPass",
      "description": "Split non-PII digital pass verification status document keyed by unguessable capability token.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Random capability pass token.",
          "minLength": 20,
          "maxLength": 128,
          "pattern": "^pass-[a-zA-Z0-9_\\-]+$"
        },
        "bookingId": {
          "type": "string",
          "description": "Paired Booking document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "event_id": {
          "type": "string",
          "description": "Referenced Match document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "match_title": {
          "type": "string",
          "description": "Snapshot of match title.",
          "minLength": 1,
          "maxLength": 120
        },
        "match_date": {
          "type": "string",
          "description": "Snapshot of match date.",
          "minLength": 1,
          "maxLength": 60
        },
        "match_time": {
          "type": "string",
          "description": "Snapshot of match time.",
          "minLength": 1,
          "maxLength": 60
        },
        "match_location": {
          "type": "string",
          "description": "Snapshot of match location.",
          "minLength": 1,
          "maxLength": 160
        },
        "amount": {
          "type": "number",
          "description": "Payment amount in ETB."
        },
        "payment_method": {
          "type": "string",
          "description": "Mobile banking channel used.",
          "enum": ["Telebirr", "CBE"],
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "description": "Live verification status synced from Host Admin review.",
          "enum": ["pending", "approved", "rejected"],
          "maxLength": 20
        },
        "lastAdminOpId": {
          "type": "string",
          "description": "ID of atomic AdminOp authorizing the write.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^op-[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest status review."
        }
      },
      "required": [
        "id",
        "bookingId",
        "event_id",
        "match_title",
        "match_date",
        "match_time",
        "match_location",
        "amount",
        "payment_method",
        "status",
        "lastAdminOpId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/config/{configId}": {
      "schema": { "$ref": "#/entities/AdminLock" },
      "description": "Unreadable one-time bootstrap lock document."
    },
    "/admin_keys/{keyId}": {
      "schema": { "$ref": "#/entities/AdminKey" },
      "description": "Server-derived 192-bit capability keys (list forbidden)."
    },
    "/admin_ops/{opId}": {
      "schema": { "$ref": "#/entities/AdminOp" },
      "description": "Unreadable one-time atomic write proofs verifying server AdminKey possession."
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Public live pickup football matches managed by server-verified AdminOp proofs."
    },
    "/admin_inboxes/{inboxKey}/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Private player booking receipts isolated inside the 192-bit server-secret admin inbox."
    },
    "/booking_passes/{passId}": {
      "schema": { "$ref": "#/entities/BookingPass" },
      "description": "Split non-PII digital pass status documents readable only by exact capability passId (list forbidden)."
    }
  }
}
