{
  "entities": {
    "AdminLock": {
      "title": "AdminLock",
      "description": "One-time bootstrap lock indicating whether the Host Admin password has been configured.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Singleton lock identifier ('admin_lock').",
          "enum": ["admin_lock"],
          "maxLength": 32
        },
        "locked": {
          "type": "boolean",
          "description": "Indicates bootstrap lock is active."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of bootstrap initialization."
        }
      },
      "required": ["id", "locked", "createdAt"]
    },
    "PublicChannel": {
      "title": "PublicChannel",
      "description": "Publicly readable asymmetric RSA-OAEP-2048 encryption channel configuration for zero-login client receipt submissions.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Singleton channel config identifier ('public_channel').",
          "enum": ["public_channel"],
          "maxLength": 32
        },
        "channelId": {
          "type": "string",
          "description": "Active booking channel collection identifier.",
          "minLength": 35,
          "maxLength": 35,
          "pattern": "^ch-[a-f0-9]{32}$"
        },
        "publicKeySpki": {
          "type": "string",
          "description": "Base64-encoded SPKI RSA-OAEP-2048 public key used by clients to encrypt player PII and payment screenshots.",
          "minLength": 200,
          "maxLength": 2000
        },
        "lastAdminOpId": {
          "type": "string",
          "description": "ID of atomic AdminOp authorizing this channel configuration.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^op-[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": ["id", "channelId", "publicKeySpki", "lastAdminOpId", "createdAt", "updatedAt"]
    },
    "TelegramBotConfig": {
      "title": "TelegramBotConfig",
      "description": "Publicly readable non-secret Telegram Bot configuration enabling Telegram Mini App and OAuth Widget account verification.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Singleton Telegram config identifier ('telegram_bot').",
          "enum": ["telegram_bot"],
          "maxLength": 32
        },
        "botId": {
          "type": "string",
          "description": "Numeric Telegram Bot ID (never contains secret token).",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[0-9]+$"
        },
        "botUsername": {
          "type": "string",
          "description": "Telegram Bot username without @ symbol.",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_]+$"
        },
        "botName": {
          "type": "string",
          "description": "Telegram Bot display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether mandatory client Telegram verification is active."
        },
        "lastAdminOpId": {
          "type": "string",
          "description": "ID of atomic AdminOp authorizing this bot configuration.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^op-[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "id",
        "botId",
        "botUsername",
        "botName",
        "enabled",
        "lastAdminOpId",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookingChannel": {
      "title": "BookingChannel",
      "description": "Master Gate parent document governing an encrypted booking channel subcollection.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique 128-bit channel identifier prefixed with ch-.",
          "minLength": 35,
          "maxLength": 35,
          "pattern": "^ch-[a-f0-9]{32}$"
        },
        "active": {
          "type": "boolean",
          "description": "Whether this channel currently accepts and serves bookings."
        },
        "publicKeySpki": {
          "type": "string",
          "description": "Base64-encoded SPKI RSA-OAEP-2048 public key bound to this channel.",
          "minLength": 200,
          "maxLength": 2000
        },
        "lastAdminOpId": {
          "type": "string",
          "description": "ID of atomic AdminOp authorizing this channel.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^op-[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": ["id", "active", "publicKeySpki", "lastAdminOpId", "createdAt", "updatedAt"]
    },
    "AdminKey": {
      "title": "AdminKey",
      "description": "192-bit HMAC-SHA256 admin capability key record derived from the Host Admin password.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "192-bit capability key prefixed with adm-.",
          "minLength": 52,
          "maxLength": 52,
          "pattern": "^adm-[a-f0-9]{48}$"
        },
        "lastAdminOpId": {
          "type": "string",
          "description": "Optional admin operation nonce when rotating keys.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^op-[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["id", "createdAt"]
    },
    "AdminVault": {
      "title": "AdminVault",
      "description": "Private capability-isolated vault storing the Host Admin RSA-OAEP-2048 private key (list forbidden).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "192-bit admin capability key matching document ID.",
          "minLength": 52,
          "maxLength": 52,
          "pattern": "^adm-[a-f0-9]{48}$"
        },
        "channelId": {
          "type": "string",
          "description": "Active booking channel identifier paired with this private key.",
          "minLength": 35,
          "maxLength": 35,
          "pattern": "^ch-[a-f0-9]{32}$"
        },
        "privateKeyPkcs8": {
          "type": "string",
          "description": "Base64-encoded PKCS8 RSA-OAEP-2048 private key accessible only with the 192-bit admin key.",
          "minLength": 800,
          "maxLength": 4000
        },
        "lastAdminOpId": {
          "type": "string",
          "description": "ID of atomic AdminOp authorizing this vault record.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^op-[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": ["id", "channelId", "privateKeyPkcs8", "lastAdminOpId", "createdAt", "updatedAt"]
    },
    "AdminOp": {
      "title": "AdminOp",
      "description": "Unreadable one-time atomic write proof verifying possession of a registered AdminKey.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique one-time operation nonce.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^op-[a-zA-Z0-9_\\-]+$"
        },
        "adminKey": {
          "type": "string",
          "description": "Secret 192-bit capability key verified against /admin_keys.",
          "minLength": 52,
          "maxLength": 52,
          "pattern": "^adm-[a-f0-9]{48}$"
        },
        "action": {
          "type": "string",
          "description": "Audited admin mutation type.",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the atomic batch."
        }
      },
      "required": ["id", "adminKey", "action", "createdAt"]
    },
    "Match": {
      "title": "Match",
      "description": "Publicly visible pickup football match in Addis Ababa with live atomic spot capacity tracking.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique match identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Display title of the football match.",
          "minLength": 1,
          "maxLength": 120
        },
        "event_type": {
          "type": "string",
          "description": "Match format category.",
          "enum": ["5-a-side", "7-a-side", "Full Field"],
          "maxLength": 30
        },
        "date": {
          "type": "string",
          "description": "Match date label.",
          "minLength": 1,
          "maxLength": 60
        },
        "time": {
          "type": "string",
          "description": "Match kickoff and end time window.",
          "minLength": 1,
          "maxLength": 60
        },
        "location": {
          "type": "string",
          "description": "Pitch name and neighborhood in Addis Ababa.",
          "minLength": 1,
          "maxLength": 160
        },
        "price": {
          "type": "number",
          "description": "Entry fee per player in ETB."
        },
        "total_spots": {
          "type": "number",
          "description": "Maximum allowed bookings before registration closes."
        },
        "verified_spots": {
          "type": "number",
          "description": "Count of admin-approved player spots."
        },
        "pending_spots": {
          "type": "number",
          "description": "Count of pending payment submissions reserving spots."
        },
        "image_url": {
          "type": "string",
          "description": "Pitch cover image URL or compressed JPEG data URL.",
          "minLength": 5,
          "maxLength": 700000
        },
        "description": {
          "type": "string",
          "description": "Match rules, footwear requirements, and notes.",
          "minLength": 0,
          "maxLength": 1000
        },
        "amenities": {
          "type": "array",
          "description": "Bounded list of up to 10 pitch amenities."
        },
        "visibility": {
          "type": "string",
          "description": "Visibility state for query enforcement ('live' or 'archived').",
          "enum": ["live", "archived"],
          "maxLength": 16
        },
        "lastBookingId": {
          "type": "string",
          "description": "ID of most recent player booking reservation.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lastAdminOpId": {
          "type": "string",
          "description": "ID of atomic AdminOp authorizing the latest admin write.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^op-[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "id",
        "title",
        "event_type",
        "date",
        "time",
        "location",
        "price",
        "total_spots",
        "verified_spots",
        "pending_spots",
        "image_url",
        "description",
        "amenities",
        "visibility",
        "lastBookingId",
        "lastAdminOpId",
        "createdAt",
        "updatedAt"
      ]
    },
    "EncryptedBooking": {
      "title": "EncryptedBooking",
      "description": "Zero-plaintext-PII player booking record where player name, phone, and receipt screenshot are asymmetrically encrypted with the Host Admin RSA-OAEP-2048 public key.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique booking identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "channelId": {
          "type": "string",
          "description": "Parent BookingChannel ID for strict query enforcement.",
          "minLength": 35,
          "maxLength": 35,
          "pattern": "^ch-[a-f0-9]{32}$"
        },
        "passId": {
          "type": "string",
          "description": "Paired non-PII capability pass identifier.",
          "minLength": 20,
          "maxLength": 128,
          "pattern": "^pass-[a-zA-Z0-9_\\-]+$"
        },
        "event_id": {
          "type": "string",
          "description": "Referenced Match document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "match_title": {
          "type": "string",
          "description": "Snapshot of match title.",
          "minLength": 1,
          "maxLength": 120
        },
        "match_date": {
          "type": "string",
          "description": "Snapshot of match date.",
          "minLength": 1,
          "maxLength": 60
        },
        "match_time": {
          "type": "string",
          "description": "Snapshot of match time.",
          "minLength": 1,
          "maxLength": 60
        },
        "match_location": {
          "type": "string",
          "description": "Snapshot of match location.",
          "minLength": 1,
          "maxLength": 160
        },
        "amount": {
          "type": "number",
          "description": "Payment amount in ETB."
        },
        "payment_method": {
          "type": "string",
          "description": "Mobile banking channel used.",
          "enum": ["Telebirr", "CBE"],
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "description": "Verification status controlled by Host Admin.",
          "enum": ["pending", "approved", "rejected"],
          "maxLength": 20
        },
        "wrappedKey": {
          "type": "string",
          "description": "RSA-OAEP-2048 encrypted 256-bit AES-GCM content key (base64).",
          "minLength": 100,
          "maxLength": 1024
        },
        "ivName": {
          "type": "string",
          "description": "Base64 12-byte AES-GCM IV for encrypted player name.",
          "minLength": 12,
          "maxLength": 32
        },
        "encName": {
          "type": "string",
          "description": "Base64 AES-GCM ciphertext of player name.",
          "minLength": 16,
          "maxLength": 512
        },
        "ivPhone": {
          "type": "string",
          "description": "Base64 12-byte AES-GCM IV for encrypted player phone.",
          "minLength": 12,
          "maxLength": 32
        },
        "encPhone": {
          "type": "string",
          "description": "Base64 AES-GCM ciphertext of player phone.",
          "minLength": 16,
          "maxLength": 256
        },
        "ivReceipt": {
          "type": "string",
          "description": "Base64 12-byte AES-GCM IV for encrypted receipt JPEG bytes.",
          "minLength": 12,
          "maxLength": 32
        },
        "encReceipt": {
          "type": "string",
          "description": "Base64 AES-GCM ciphertext of compressed JPEG receipt screenshot.",
          "minLength": 20,
          "maxLength": 750000
        },
        "ivTg": {
          "type": "string",
          "description": "Base64 12-byte AES-GCM IV for encrypted verified Telegram account metadata.",
          "minLength": 12,
          "maxLength": 32
        },
        "encTg": {
          "type": "string",
          "description": "Base64 AES-GCM ciphertext of verified Telegram account JSON payload.",
          "minLength": 16,
          "maxLength": 1024
        },
        "lastAdminOpId": {
          "type": "string",
          "description": "Optional ID of atomic AdminOp when Host Admin approves or rejects.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^op-[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest status review."
        }
      },
      "required": [
        "id",
        "channelId",
        "passId",
        "event_id",
        "match_title",
        "match_date",
        "match_time",
        "match_location",
        "amount",
        "payment_method",
        "status",
        "wrappedKey",
        "ivName",
        "encName",
        "ivPhone",
        "encPhone",
        "ivReceipt",
        "encReceipt",
        "createdAt",
        "updatedAt"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Legacy server-inbox booking receipt isolated under 192-bit AdminKey.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
