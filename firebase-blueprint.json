          "maxLength": 120
        },
        "match_date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "match_time": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "match_location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "player_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "player_phone": {
          "type": "string",
