  "firestore": {
    "/config/{configId}": {
      "schema": { "$ref": "#/entities/AdminLock" },
      "description": "Singleton bootstrap lock document indicating admin password setup state (list forbidden)."
    },
    "/booking_config/{channelConfigId}": {
      "schema": { "$ref": "#/entities/PublicChannel" },
      "description": "Singleton public RSA-OAEP-2048 encryption channel and TelegramBotConfig descriptors (list forbidden)."
    },
    "/booking_channels/{channelId}": {
      "schema": { "$ref": "#/entities/BookingChannel" },
      "description": "Master Gate parent documents for encrypted booking channels (list forbidden)."
    },
    "/booking_channels/{channelId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/EncryptedBooking" },
      "description": "Asymmetrically encrypted player booking receipts governed by parent BookingChannel Master Gate."
    },
    "/admin_keys/{keyId}": {
      "schema": { "$ref": "#/entities/AdminKey" },
      "description": "192-bit HMAC capability keys derived from Host Admin password (list forbidden)."
    },
    "/admin_vault/{keyId}": {
      "schema": { "$ref": "#/entities/AdminVault" },
      "description": "Capability-isolated Host Admin private decryption key vault (list forbidden)."
    },
    "/admin_ops/{opId}": {
      "schema": { "$ref": "#/entities/AdminOp" },
      "description": "Unreadable one-time atomic write proofs verifying AdminKey possession."
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Public live pickup football matches with atomic player spot claims and AdminOp management."
    },
    "/admin_inboxes/{inboxKey}/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Legacy server-inbox booking receipts isolated under 192-bit AdminKey."
    },
    "/booking_passes/{passId}": {
